# Server
PORT=3002

# PostgreSQL with the PostGIS extension enabled
DATABASE_URL=postgresql://user:password@host:5432/rentiful

# AWS Cognito (same user pool the Next.js client is configured with)
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 for property photos (credentials come from the instance role or the AWS CLI profile)
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-bucket-name
